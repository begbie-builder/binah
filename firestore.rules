rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProgress() {
      let data = request.resource.data;
      let p = data.progress;
      return data.keys().hasOnly(['progress', 'updatedAt'])
        && data.updatedAt == request.time
        && p.keys().hasOnly(['version','name','form','transliteration','vowels','goal','completed','cards','traced','activity','game','updatedAt'])
        && p.version == 1
        && p.name is string && p.name.size() <= 60
        && p.form in ['m','f']
        && p.transliteration is bool && p.vowels is bool
        && p.goal in [20,30,50]
        && p.completed is map && p.completed.size() <= 200
        && p.cards is map && p.cards.size() <= 1000
        && p.traced is list && p.traced.size() <= 27
        && p.activity is map && p.activity.size() <= 730
        && p.updatedAt is number
        && (!('game' in p) || (p.game is map
          && p.game.keys().hasOnly(['version','startedAt','checkedThrough','purchases','freezes','days','writing'])
          && p.game.version == 1
          && p.game.startedAt is number && p.game.checkedThrough is string
          && p.game.purchases is map && p.game.purchases.size() <= 1000
          && p.game.freezes is map && p.game.freezes.size() <= 730
          && p.game.days is map && p.game.days.size() <= 730
          && p.game.writing is map && p.game.writing.size() <= 40));
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validProgress();
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
